{
  "name": "timenow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:api": "node --env-file=.env --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1 --strictPort",
    "db:migrate": "node --env-file=.env server/db.mjs",
    "test:integration": "node --env-file=.env --test server/*.test.mjs",
    "auth:setup": "node --env-file=.env server/auth-setup.mjs setup",
    "auth:reset-password": "node --env-file=.env server/auth-setup.mjs reset-password",
    "auth:rotate-agent-key": "node --env-file=.env server/auth-setup.mjs rotate-agent-key"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.14",
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/themes": "^3.3.0",
    "better-auth": "1.7.14",
    "lucide-react": "^0.577.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.6",
    "typescript": "^6.0.2",
    "vite": "^8.3.5"
  }
}
