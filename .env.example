# Local PostgreSQL only. Replace the password and URL-encode it in DATABASE_URL.
# Do not prefix database credentials with VITE_: they must stay server-side.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://timenow:replace-with-local-password@127.0.0.1:5432/timenow

# Public app origin. Both loopback hostnames are accepted for local development.
BETTER_AUTH_URL=http://localhost:5173
# auth:setup generates this locally. Set a separate random secret on Railway.
BETTER_AUTH_SECRET=
